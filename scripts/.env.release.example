# Copy this file to .env.release (same folder) and fill in the values.
# .env.release is gitignored — keys never reach the repo.
#
# Source: the same DigitalOcean Spaces credentials the server uses in
# its .env (STORAGE_ACCESS_KEY_ID + STORAGE_SECRET_ACCESS_KEY). Copy
# them over for the release pipeline; do NOT generate new ones unless
# you want to scope a separate "desktop releases" key.

DO_SPACES_KEY=
DO_SPACES_SECRET=
